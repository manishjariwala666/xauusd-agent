# Required by every application process.
# Supabase Dashboard > Project Settings > Database > Connection string.
DATABASE_URL=
# Supabase Dashboard > Project Settings > API.
SUPABASE_URL=
SUPABASE_KEY=
# Generate a private random value of at least 32 characters.
JWT_SECRET=

# Authentication and email delivery.
JWT_ISSUER=ai-market-analytics-pro
JWT_TTL_MINUTES=60
ADMIN_BFF_SHARED_SECRET=
ADMIN_SESSION_TTL_MINUTES=15
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_STAGING_ONLY=false
APP_BASE_URL=
BACKEND_BASE_URL=
PUBLIC_WEBSITE_URL=
PUBLIC_SITE_URL=
STREAMLIT_PUBLIC_URL=
PUBLIC_API_URL=
BLOCK_SEARCH_INDEXING=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_USE_TLS=true
GOOGLE_OAUTH_LOGIN_URL=

# Telegram BotFather, Telegram channel/chat, and a private webhook secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
MASTER_AI_TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_USER_IDS=
MASTER_AI_ALLOW_NATURAL_COMMANDS=false
TELEGRAM_INVITE_URL=
PROFIT_PROOF_TELEGRAM_URL=

# Meta for Developers > WhatsApp Business Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
SUPPORT_WHATSAPP_URL=

# Google Cloud service account and the shared Google Sheet.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_NAME=xauusd_automation
GOOGLE_WORKSHEET_NAME=Sheet1

# Market data. GOLDAPI_KEY is optional; Yahoo is the fallback provider.
GOLDAPI_KEY=
XAUUSD_SYMBOL=GC=F
SIGNAL_POLL_SECONDS=60

# AI providers. OpenAI is the primary text LLM and image provider.
# Gemini remains available only when explicitly selected/configured.
AI_PROVIDER=OPENAI
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_TEXT_MODEL=gpt-5
AI_IMAGE_MODEL=gpt-image-1

# Subscription, branding, and support.
USDT_WALLET_ADDRESS=
USDT_NETWORK=
SUBSCRIPTION_PRICE_USDT=
SUPPORT_EMAIL=
BRAND_NAME=AI Market Analytics Pro

# Worker behavior.
HUMAN_TAKEOVER_MINUTES=30
WORKER_POLL_SECONDS=5

# Optional read-only USA/Canada high-impact economic calendar provider.
TRADING_ECONOMICS_API_KEY=
